# Copy to .env and adjust as needed. `docker compose` reads .env automatically.

# PostgreSQL (compose.yaml)
POSTGRES_USER=undocx
POSTGRES_PASSWORD=undocx
POSTGRES_DB=undocx
POSTGRES_PORT=5432

# Connection string for the app (Next.js reads .env too)
DATABASE_URL=postgresql://undocx:undocx@127.0.0.1:5432/undocx

# Better Auth (https://better-auth.com)
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app. Used to build the OAuth callback URL.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File storage: MinIO, S3-compatible (compose.yaml)
S3_ACCESS_KEY_ID=undocx
S3_SECRET_ACCESS_KEY=undocx-secret
S3_BUCKET=undocx
S3_PORT=9000
S3_CONSOLE_PORT=9001
# How the app reaches storage. Path-style addressing is required for MinIO.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# AI: Vercel AI SDK with the OpenAI provider (@ai-sdk/openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional: point at a proxy or OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

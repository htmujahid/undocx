# Copy to .env and adjust as needed. `docker compose` reads .env automatically.

# PostgreSQL (compose.yaml)
POSTGRES_USER=undocx
POSTGRES_PASSWORD=undocx
POSTGRES_DB=undocx
POSTGRES_PORT=5432

# Connection string for the app (Next.js reads .env too)
DATABASE_URL=postgresql://undocx:undocx@127.0.0.1:5432/undocx

# Better Auth (https://better-auth.com)
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app. Used to build the OAuth callback URL.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File storage: MinIO, S3-compatible (compose.yaml)
S3_ACCESS_KEY_ID=undocx
S3_SECRET_ACCESS_KEY=undocx-secret
S3_BUCKET=undocx
S3_PORT=9000
S3_CONSOLE_PORT=9001
# How the app reaches storage. Path-style addressing is required for MinIO.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# AI: Vercel AI SDK with the OpenAI provider (@ai-sdk/openai)
OPENAI_API_KEY=
# Optional: force one model for every task (for example a cheap one while testing).
# Leave unset to route each task to its own model by plan (lib/ai/model.ts).
# OPENAI_MODEL=
# Optional: point at a proxy or OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

# Billing: Polar (https://polar.sh) through @polar-sh/better-auth
# Organization access token with checkouts, customers, customer sessions and subscriptions scopes.
POLAR_ACCESS_TOKEN=
# "sandbox" for sandbox.polar.sh, "production" for polar.sh
POLAR_ENVIRONMENT=sandbox
# Webhook endpoint: ${BETTER_AUTH_URL}/api/auth/polar/webhooks (events: subscription.*, customer.state_changed)
POLAR_WEBHOOK_SECRET=
# Product id of the recurring Pro product ($10 per month)
POLAR_PRO_PRODUCT_ID=
# Optional: point at another Polar API (tests)
# POLAR_BASE_URL=

# Retrieval: a scheduler calls GET /api/retrieval/index every minute with "Authorization: Bearer $CRON_SECRET"
# to index edited documents. Chat also indexes the asking user's pending documents on demand.
CRON_SECRET=
